<% include partials/head %>
<div class="wrapper">
	<h1>
	<%= title %>
	</h1>
	<div class="ra-r"></div>

	<div class="booking-form">
		<form action="/trainingSession/create" method="post">
			<label for="trainingTopic">RPA training topic</label>
			<select id="trainingTopic" name="trainingTopic" required>
				<option value="UiPath Fundamentals">UiPath Fundamentals</option>
				<option value="Process Analysis and Automation Design">Process Analysis and Automation Design
				</option>
				<option value="Working with Queues and Orchestrator">Working with Queues and Orchestrator
				</option>
				<option value="Exception Handling and Troubleshooting">Exception Handling and Troubleshooting
				</option>
			</select>

			<label for="personName">Participant name</label>
			<input type="text" id="personName" name="personName" required>

			<label for="personId">Participant ID</label>
			<input type="text" id="personId" name="personId" minlength="10" maxlength="10" required>

			<label for="sessionDate">Training date and time</label>
			<input type="datetime-local" id="sessionDate" name="sessionDate" required>

			<label for="cardNumber">Card number</label>
			<input type="text" id="cardNumber" name="cardNumber" required>

			<label for="cardExpiry">Expiry date</label>
			<input type="text" id="cardExpiry" name="cardExpiry" placeholder="MM/YY" required>

			<label for="securityCode">Security code</label>
			<input type="password" id="securityCode" name="securityCode" required>

			<button type="submit">Book session</button>
		</form>
	</div>

</div>
<% include partials/foot %>
