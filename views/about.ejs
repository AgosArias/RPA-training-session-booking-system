<% include partials/head %>
<div class="wrapper">
	<h1><%= title %></h1>
	<div class="ra-r">
	<section class="info-hero">
		<p class="info-kicker">ABOUT THE PROJECT</p>
		<p class="info-intro">
			RPA Training is a booking website for practical sessions on
			Robotic Process Automation. It helps participants explore
			training topics and register for a session.
		</p>
		<a class="info-button" href="/trainingSession/create">
			Book a training session
		</a>
	</section>

	<section class="info-cards">
		<article class="info-card">
			<span>01</span>
			<h2>Explore RPA</h2>
			<p>Learn about automation concepts and process analysis.</p>
		</article>

		<article class="info-card">
			<span>02</span>
			<h2>Build practical skills</h2>
			<p>Explore UiPath, Orchestrator, queues and exception handling.</p>
		</article>

		<article class="info-card">
			<span>03</span>
			<h2>Book a session</h2>
			<p>Choose a training topic and submit your booking details.</p>
		</article>
	</section>	</div>
</div>
<% include partials/foot %>