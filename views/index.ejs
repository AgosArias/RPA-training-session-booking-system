<% include partials/head %>
<div class="wrapper">
	<h1><%= title %></h1>
		<section class="rpa-hero">
		<div class="hero-copy">
			<p class="hero-kicker">
				RPA TRAINING · LEARN BY DOING
			</p>

			<h1>
				Make repetitive work
				<span>work smarter.</span>
			</h1>

			<p class="hero-description">
				Build practical automation skills, understand how processes
				can be improved, and explore the tools behind RPA.
			</p>

			<div class="hero-actions">
				<a class="hero-button" href="/trainingSession/create">
					Book a training session
				</a>
				<a class="hero-secondary" href="/trainingSession">
					Explore sessions
				</a>
			</div>

			<p class="hero-note">Practical topics. Real automation skills.</p>
		</div>

		<div class="automation-card">
			<h2>The automation process</h2>
			<p><strong>1. Understand:</strong> Map the process.</p>
			<p><strong>2. Automate:</strong> Build with RPA.</p>
			<p><strong>3. Improve:</strong> Make work flow.</p>
		</div>
	</section>

	<section class="topics-section">
		<div class="topics-heading">
			<p class="section-kicker">WHAT YOU CAN LEARN</p>
			<h2>Find your next automation skill.</h2>
		</div>

		<div class="topic-grid">
			<article class="topic-card">
				<span class="topic-index">01</span>
				<h3>UiPath Fundamentals</h3>
				<p>Get started with the essentials of RPA.</p>
			</article>

			<article class="topic-card">
				<span class="topic-index">02</span>
				<h3>Process Analysis</h3>
				<p>Explore how to identify and design automation opportunities.</p>
			</article>

			<article class="topic-card">
				<span class="topic-index">03</span>
				<h3>Queues &amp; Orchestrator</h3>
				<p>Learn how automation processes are organised and managed.</p>
			</article>

			<article class="topic-card">
				<span class="topic-index">04</span>
				<h3>Exception Handling</h3>
				<p>Understand troubleshooting and handling process errors.</p>
			</article>
		</div>
	</section>
</div>
<% include partials/foot %>